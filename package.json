{
  "name": "superteam",
  "private": true,
  "scripts": {
    "format:md": "prettier --write \"**/*.md\"",
    "test": "node --test \"superteam-engine/src/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage \"superteam-engine/src/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write \"**/*.js\""
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10"
  }
}
