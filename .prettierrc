{
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always",
        "printWidth": 80
      }
    },
    {
      "files": "*.js",
      "options": {
        "singleQuote": false,
        "printWidth": 80,
        "trailingComma": "all",
        "semi": true
      }
    }
  ]
}
